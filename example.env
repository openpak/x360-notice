# HTTP listen address. Plain HTTP only: real consoles reach this on port 80 because DNS
# sends xncsi.xboxlive.com and notice.xbox.com to OpenPak, and the reverse proxy in front
# (Traefik) forwards port 80 for those two Host names here.
X360_NOTICE_ADDR=:8080

# Optional. The service-status message the dashboard shows.
# X360_NOTICE_STATUS_TEXT=Xbox LIVE is up and running
